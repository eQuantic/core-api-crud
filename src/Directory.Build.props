<Project>

    <!-- Shared version and metadata for the packable src/ projects. The Version below is the
         development default; releases stamp the real version via semantic-release (release-prepare.sh).
         Target frameworks stay per-project (the sample targets net8 only). -->
    <PropertyGroup>
        <Version>2.0.0</Version>
        <Authors>eQuantic Tech</Authors>
        <Company>eQuantic Tech</Company>
        <Copyright>2026 eQuantic Tech</Copyright>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

</Project>
